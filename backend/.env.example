# Backend Environment Configuration Template
NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/gari_lagbe?retryWrites=true&w=majority
JWT_SECRET=your_production_jwt_secret_key_here_min_32_chars
CLIENT_URL=https://gari-lagbe.vercel.app,http://localhost:5173

# Email / Nodemailer SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="গাড়ি লাগবে সাপোর্ট" <support@gari-lagbe.com>
